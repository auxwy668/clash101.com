---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/data/siteConfig';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles', ({ data }) => !data.draft);
const sorted = articles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 8);
const primary = '#6366f1';
const bgCard = '#f5f7fa';
const textPrimary = '#1e293b';
---

<BaseLayout>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet" />

  <!-- ── Hero ── -->
  <section class="text-white text-center" style="background:linear-gradient(135deg,#1a56db 0%,#1e40af 40%,#1e3a5f 100%);padding:80px 24px 64px">
    <h1 class="text-4xl md:text-5xl font-bold mb-4">Clash 中文全知识库 — 从零入门到精通</h1>
    <p class="text-lg md:text-xl opacity-90 max-w-2xl mx-auto mb-8">最全面的 Clash Verge Rev 中文教程站。涵盖下载安装、订阅配置、规则分流、TUN模式、YAML语法、故障排查。支持 Windows / macOS / Linux / Android 全平台。</p>
    <div class="flex flex-wrap justify-center gap-4 mb-8">
      <a href="/guide/clash-xinshou-rumen/" class="bg-white text-blue-700 font-bold px-8 py-3 rounded-full text-lg hover:shadow-xl transition">🔥 新手入门教程</a>
      <a href="/download/clash-verge-rev-download-install-all-platforms/" class="bg-green-500 text-white font-bold px-8 py-3 rounded-full text-lg hover:bg-green-600 transition">⬇ 立即下载</a>
    </div>
    <div class="flex flex-wrap justify-center gap-3 text-sm opacity-80">
      <span class="bg-white/10 px-3 py-1 rounded">🖥 Windows</span>
      <span class="bg-white/10 px-3 py-1 rounded">🍎 macOS</span>
      <span class="bg-white/10 px-3 py-1 rounded">🐧 Linux</span>
      <span class="bg-white/10 px-3 py-1 rounded">📱 Android</span>
    </div>
  </section>

  <!-- ── 核心功能展示 ── -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-3xl font-bold text-center mb-12" style={`color:${textPrimary}`}>为什么选择 Clash？六大核心能力</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white rounded-xl p-6 border hover:shadow-lg transition">
        <div class="text-4xl mb-4">🧠</div>
        <h3 class="text-lg font-bold mb-2" style={`color:${primary}`}>智能规则分流</h3>
        <p class="text-sm text-gray-600">国内网站直连不减速，国外网站走代理通道，互不干扰。GEOIP自动识别，无需手动切换。</p>
      </div>
      <div class="bg-white rounded-xl p-6 border hover:shadow-lg transition">
        <div class="text-4xl mb-4">🔐</div>
        <h3 class="text-lg font-bold mb-2" style={`color:${primary}`}>TUN 全局接管</h3>
        <p class="text-sm text-gray-600">虚拟网卡层接管所有流量——命令行、游戏、系统更新统统走代理，不漏任何一个请求。</p>
      </div>
      <div class="bg-white rounded-xl p-6 border hover:shadow-lg transition">
        <div class="text-4xl mb-4">📋</div>
        <h3 class="text-lg font-bold mb-2" style={`color:${primary}`}>一键导入订阅</h3>
        <p class="text-sm text-gray-600">粘贴机场订阅链接即可自动导入节点列表，支持 Clash/Shadowsocks/Trojan/V2Ray 多协议。</p>
      </div>
      <div class="bg-white rounded-xl p-6 border hover:shadow-lg transition">
        <div class="text-4xl mb-4">⚡</div>
        <h3 class="text-lg font-bold mb-2" style={`color:${primary}`}>自动延迟测速</h3>
        <p class="text-sm text-gray-600">定时检测所有节点延迟，自动切换到最快节点。支持自定义测速URL和间隔时间。</p>
      </div>
      <div class="bg-white rounded-xl p-6 border hover:shadow-lg transition">
        <div class="text-4xl mb-4">🔧</div>
        <h3 class="text-lg font-bold mb-2" style={`color:${primary}`}>YAML配置文件</h3>
        <p class="text-sm text-gray-600">完善的YAML配置语法，自定义规则链、代理组、DNS设置、脚本扩展。高级用户的终极武器。</p>
      </div>
      <div class="bg-white rounded-xl p-6 border hover:shadow-lg transition">
        <div class="text-4xl mb-4">🌍</div>
        <h3 class="text-lg font-bold mb-2" style={`color:${primary}`}>开源免费</h3>
        <p class="text-sm text-gray-600">基于 Clash Meta 内核，GPL-3.0 开源协议，社区驱动持续更新。拒绝捆绑和广告，安全可信。</p>
      </div>
    </div>
  </section>

  <!-- ── 分类导航卡片 ── -->
  <section style={`background:${bgCard};padding:64px 24px`}>
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-12" style={`color:${textPrimary}`}>从零到精通，按需学习</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {siteConfig.categories.map((cat) => (
          <a href={`/articles/?category=${cat.id}`} class="bg-white rounded-xl p-6 text-center border hover:border-blue-400 hover:shadow-md transition no-underline" style="color:inherit">
            <div class="text-3xl mb-3">{cat.id === 'download' ? '📥' : cat.id === 'guide' ? '📖' : cat.id === 'config' ? '⚙️' : '🔧'}</div>
            <h3 class="font-bold text-lg mb-1" style={`color:${primary}`}>{cat.name}</h3>
            <p class="text-sm text-gray-500">{cat.id === 'download' ? '全平台下载安装教程' : cat.id === 'guide' ? '新手入门快速上手' : cat.id === 'config' ? '规则/TUN/DNS/订阅进阶' : '连不上/代理不生效/报错排错'}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 最新教程列表 ── -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="flex justify-between items-center mb-10">
      <h2 class="text-3xl font-bold" style={`color:${textPrimary}`}>📝 最新教程</h2>
      <a href="/articles/" class="text-sm font-semibold no-underline" style={`color:${primary}`}>查看全部 →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sorted.map((article) => (
        <a href={`/${article.id}/`} class="flex gap-4 bg-white rounded-xl p-5 border hover:shadow-md transition no-underline" style="color:inherit">
          <div class="flex-1">
            <span class="inline-block text-xs font-bold px-2 py-1 rounded mb-2">{siteConfig.catLabels?.[article.data.category] || article.data.category}</span>
            <h3 class="font-bold text-base mb-1">{article.data.title}</h3>
            <p class="text-sm text-gray-500 line-clamp-2">{article.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ── Clash 架构图解 ── -->
  <section style="background:linear-gradient(135deg,#1e3a5f,#1e40af);color:#fff;padding:64px 24px">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-6">Clash 工作原理：一张图看懂</h2>
      <p class="text-lg opacity-80 mb-10">你的每一个网络请求，Clash 都会这样处理</p>
      <div class="bg-white/10 rounded-2xl p-8 backdrop-blur">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 text-center">
          <div class="p-4"><div class="text-3xl mb-2">🖥</div><div class="font-bold">你的设备</div><div class="text-sm opacity-70 mt-1">发出网络请求</div></div>
          <div class="p-4"><div class="text-3xl mb-2">➡️</div><div class="font-bold">规则匹配</div><div class="text-sm opacity-70 mt-1">DOMAIN / GEOIP / MATCH</div></div>
          <div class="p-4"><div class="text-3xl mb-2">🔀</div><div class="font-bold">策略分流</div><div class="text-sm opacity-70 mt-1">直连/DIRECT 或 代理/PROXY</div></div>
          <div class="p-4"><div class="text-3xl mb-2">🌍</div><div class="font-bold">访问目标</div><div class="text-sm opacity-70 mt-1">国内直连 · 国外走节点</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Clash 客户端对比 ── -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-3xl font-bold text-center mb-4" style={`color:${textPrimary}`}>Clash 客户端横向对比</h2>
    <p class="text-center text-gray-500 mb-10">选哪个客户端最适合你？一表对比</p>
    <div class="overflow-x-auto">
      <table class="w-full text-sm border-collapse bg-white rounded-xl overflow-hidden border">
        <thead style={`background:${primary};color:#fff`}>
          <tr>
            <th class="p-4 text-left">客户端</th>
            <th class="p-4">平台</th>
            <th class="p-4">内核</th>
            <th class="p-4">TUN模式</th>
            <th class="p-4">中文</th>
            <th class="p-4">推荐人群</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b"><td class="p-4 font-bold">Clash Verge Rev</td><td class="p-4 text-center">Win/Mac/Linux</td><td class="p-4 text-center">Mihomo</td><td class="p-4 text-center">✅</td><td class="p-4 text-center">✅</td><td class="p-4 text-sm">⭐ 绝大多数用户首选</td></tr>
          <tr class="border-b bg-gray-50"><td class="p-4 font-bold">Mihomo Party</td><td class="p-4 text-center">Win/Mac/Linux</td><td class="p-4 text-center">Mihomo</td><td class="p-4 text-center">✅</td><td class="p-4 text-center">✅</td><td class="p-4 text-sm">多机场管理/高级用户</td></tr>
          <tr class="border-b"><td class="p-4 font-bold">FlClash</td><td class="p-4 text-center">Android</td><td class="p-4 text-center">Mihomo</td><td class="p-4 text-center">✅</td><td class="p-4 text-center">✅</td><td class="p-4 text-sm">安卓用户首选</td></tr>
          <tr class="border-b bg-gray-50"><td class="p-4 font-bold">ClashX Meta</td><td class="p-4 text-center">macOS</td><td class="p-4 text-center">Mihomo</td><td class="p-4 text-center">✅</td><td class="p-4 text-center">✅</td><td class="p-4 text-sm">Mac 原生体验爱好者</td></tr>
          <tr><td class="p-4 font-bold">Clash N</td><td class="p-4 text-center">Win/Mac/Linux</td><td class="p-4 text-center">Mihomo</td><td class="p-4 text-center">✅</td><td class="p-4 text-center">✅</td><td class="p-4 text-sm">追求简单/新手友好</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section style={`background:${bgCard};padding:64px 24px`}>
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-12" style={`color:${textPrimary}`}>常见问题</h2>
      <div class="space-y-3">
        <details class="bg-white rounded-xl p-5 border"><summary class="font-bold cursor-pointer">Clash 是什么？和普通 VPN 有什么区别？</summary><p class="mt-3 text-gray-600 text-sm">Clash 是一个基于规则的代理客户端，不是传统 VPN。它能智能分流国内外流量——国内网站直连、国外网站走代理。相比 VPN 的"全局代理"，Clash 更灵活、更快、对正常上网影响更小。</p></details>
        <details class="bg-white rounded-xl p-5 border"><summary class="font-bold cursor-pointer">Clash Verge Rev 怎么导入订阅链接？</summary><p class="mt-3 text-gray-600 text-sm">打开 Clash Verge Rev → 点击左侧「订阅」→ 点击右上角「新建」→ 粘贴机场提供的订阅链接 → 保存。Clash 会自动拉取节点列表。</p></details>
        <details class="bg-white rounded-xl p-5 border"><summary class="font-bold cursor-pointer">TUN 模式是什么？需要开启吗？</summary><p class="mt-3 text-gray-600 text-sm">TUN 模式会在系统网络层创建虚拟网卡，接管所有程序的流量。如果你发现某些软件不走代理（如命令行工具、游戏），开启 TUN 模式通常能解决。</p></details>
        <details class="bg-white rounded-xl p-5 border"><summary class="font-bold cursor-pointer">Clash 连不上/代理不生效怎么办？</summary><p class="mt-3 text-gray-600 text-sm">先检查系统代理开关是否打开、节点是否在线、规则配置是否正确。常见解决方案：切换节点、开启TUN模式、检查防火墙、更新内核。</p></details>
        <details class="bg-white rounded-xl p-5 border"><summary class="font-bold cursor-pointer">Clash 规则分流怎么配置才不影响国内网站？</summary><p class="mt-3 text-gray-600 text-sm">默认规则已内置 GEOIP 和常见域名分流。核心逻辑：GEOIP,CN,DIRECT 让中国IP直连；DOMAIN-SUFFIX,google.com,PROXY 让 Google 走代理。一般无需修改。</p></details>
        <details class="bg-white rounded-xl p-5 border"><summary class="font-bold cursor-pointer">哪个 Clash 客户端最好用？</summary><p class="mt-3 text-gray-600 text-sm">Windows用户推荐 Clash Verge Rev（开源、稳定、中文界面）；macOS可选 ClashX Meta；Android推荐 FlClash。所有客户端兼容同一份订阅。</p></details>
      </div>
    </div>
  </section>

  <!-- ── 底部CTA ── -->
  <section class="text-center text-white" style="background:linear-gradient(135deg,#1e40af,#6366f1);padding:64px 24px">
    <h2 class="text-3xl font-bold mb-4">准备好开始了吗？</h2>
    <p class="text-lg opacity-80 mb-8 max-w-xl mx-auto">15 分钟，从下载到流畅使用 Clash，轻松访问全球互联网。</p>
    <a href="/guide/clash-xinshou-rumen/" class="inline-block bg-white text-blue-700 font-bold px-10 py-4 rounded-full text-lg hover:shadow-2xl transition">🚀 开始入门教程</a>
  </section>

  <style>
    .line-clamp-2 { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    details summary { list-style:none; }
    details summary::-webkit-details-marker { display:none; }
    details[open] summary { color:#6366f1; }
  </style>
</BaseLayout>
